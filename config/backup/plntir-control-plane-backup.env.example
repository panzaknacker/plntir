# installed as /etc/plntir/control-plane-backup.env with mode 0600.
# create a bucket-scoped R2 object read & write token. bucket locks protect
# uploaded snapshots from deletion or overwrite during the retention window.
R2_ACCOUNT_ID=REPLACE_WITH_32_HEX_ACCOUNT_ID
R2_BUCKET=plntir-control-plane-backups
R2_JURISDICTION=default
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
