[Unit]
Description=Plntir Endpoint Security telemetry for secure agent workflows
After=network-online.target warp-svc.service
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=plntircontrol
ExecStart=/opt/plntir/bin/plntir-security-collect
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/plntir/monitor
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
