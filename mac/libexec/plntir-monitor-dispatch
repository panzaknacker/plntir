#!/bin/bash
set -Eeuo pipefail

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C
umask 077
readonly command=${SSH_ORIGINAL_COMMAND-}

exec </dev/null
case "${command}" in
health-v1)
    exec /usr/local/libexec/plntir-health-collector
    ;;
posture-v1)
    exec /usr/bin/nice -n 10 \
        /usr/bin/sudo -n /usr/local/libexec/plntir-security-collector posture
    ;;
telemetry-v1)
    exec /usr/bin/nice -n 10 \
        /usr/bin/sudo -n /usr/local/libexec/plntir-security-collector telemetry
    ;;
*)
    printf 'Plntir Endpoint Agent monitor command denied\n' >&2
    exit 126
    ;;
esac
