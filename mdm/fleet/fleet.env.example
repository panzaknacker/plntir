# copy to a root-readable file outside the repository (mode 0600).
FLEET_HOSTNAME=mdm.plntir.example
# safe staging defaults. bind the raw UI to the private address only for an
# approved bootstrap/recovery window after nftables allows TCP/1337 solely
# from plntir-relay-01. It is never a Tunnel origin.
FLEET_ADMIN_BIND_ADDRESS=127.0.0.1
# bind the device ingress to the private address only after nftables allows
# TCP/1338 solely from plntir-edge-01 and plntir-relay-01.
FLEET_DEVICE_BIND_ADDRESS=127.0.0.1
MYSQL_ROOT_PASSWORD=replace-with-random-32-plus-characters
MYSQL_PASSWORD=replace-with-a-different-random-32-plus-characters
FLEET_SERVER_PRIVATE_KEY=replace-with-openssl-rand-base64-32-output
