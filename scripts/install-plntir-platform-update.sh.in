#!/bin/bash
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
    printf 'Run this installer with sudo from an authenticated Plntir administrator session.\n' >&2
    exit 1
fi
if [[ $(/usr/bin/uname -s) != Darwin ]]; then
    printf 'This installer only supports macOS.\n' >&2
    exit 69
fi

PACKAGE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
readonly PACKAGE_DIR
readonly PAYLOAD_DIR=${PACKAGE_DIR}/payloads
readonly ENDPOINT_ARCHIVE=${PAYLOAD_DIR}/plntir-endpoint-update.tar.gz
readonly ACCESS_ARCHIVE=${PAYLOAD_DIR}/plntir-access-upgrade.tar.gz
readonly ENDPOINT_CHECKSUM=@ENDPOINT_CHECKSUM@
readonly ACCESS_CHECKSUM=@ACCESS_CHECKSUM@
readonly RELEASE_ID=@RELEASE_ID@
readonly PLNTIR_SHARED_ROOT=/Users/Shared/.plntir
readonly RESULT_ROOT=${PLNTIR_SHARED_ROOT}/results
readonly RESULT_DIR=${RESULT_ROOT}/platform-update
readonly STATUS_FILE=${RESULT_DIR}/status.json
readonly LOG_FILE=${RESULT_DIR}/install.log

write_status() {
    local state=$1
    local stage=$2
    local rc=$3
    local now tmp
    now=$(/bin/date -u +%Y-%m-%dT%H:%M:%SZ)
    tmp=${STATUS_FILE}.$$
    /usr/bin/printf '{"state":"%s","stage":"%s","rc":%d,"updated_at":"%s"}\n' \
        "${state}" "${stage}" "${rc}" "${now}" >"${tmp}"
    /bin/chmod 0644 "${tmp}"
    /bin/mv -f "${tmp}" "${STATUS_FILE}"
}

for directory in "${PLNTIR_SHARED_ROOT}" "${RESULT_ROOT}"; do
    if [[ -L ${directory} || (-e ${directory} && ! -d ${directory}) ]]; then
        printf 'Unsafe Plntir result parent: %s\n' "${directory}" >&2
        exit 77
    fi
    if [[ ! -e ${directory} ]]; then
        /bin/mkdir -m 0755 "${directory}"
    fi
    /usr/sbin/chown root:wheel "${directory}"
    /bin/chmod 0755 "${directory}"
    /usr/bin/chflags hidden "${directory}" 2>/dev/null || true
done

# keep known pre-migration plntir artifacts available for rollback while
# removing their purely cosmetic finder clutter. finder flags do not rename
# paths or alter their contents, ownership, or permissions.
for legacy_directory in \
    /Users/Shared/Plntir-Platform-Update \
    /Users/Shared/PlntirSecureArchive \
    /Users/Shared/plntir-access-upgrade-results \
    /Users/Shared/plntir-endpoint-update-results \
    /Users/Shared/plntir-platform-update-results; do
    if [[ -d ${legacy_directory} && ! -L ${legacy_directory} ]]; then
        /usr/bin/chflags hidden "${legacy_directory}" 2>/dev/null || true
    fi
done

if [[ -L ${RESULT_DIR} || (-e ${RESULT_DIR} && ! -d ${RESULT_DIR}) ]]; then
    printf 'Unsafe result path: %s\n' "${RESULT_DIR}" >&2
    exit 77
fi
if [[ ! -e ${RESULT_DIR} ]]; then
    /bin/mkdir -m 0755 "${RESULT_DIR}"
fi
if [[ $(/usr/bin/stat -f %Su "${RESULT_DIR}") != root ]]; then
    printf 'Result directory must be owned by root.\n' >&2
    exit 77
fi
if [[ -n $(/usr/bin/find "${RESULT_DIR}" -maxdepth 0 \( -perm -020 -o -perm -002 \) -print -quit) ]]; then
    printf 'Result directory must not be group/other-writable.\n' >&2
    exit 77
fi
if [[ -L ${LOG_FILE} || -L ${STATUS_FILE} ]]; then
    printf 'Refusing unsafe result-file symlink.\n' >&2
    exit 77
fi
/usr/bin/touch "${LOG_FILE}"
/bin/chmod 0644 "${LOG_FILE}"
exec > >(/usr/bin/tee -a "${LOG_FILE}") 2>&1

stage=bootstrap
finished=false
workdir=''
on_exit() {
    local rc=$?
    trap - EXIT
    if [[ -n ${workdir} ]]; then
        case ${workdir} in
        /private/var/tmp/plntir-platform-install.*)
            /bin/rm -rf "${workdir}"
            ;;
        *)
            printf 'Refusing unsafe temporary cleanup path.\n' >&2
            ;;
        esac
    fi
    if [[ ${finished} == true && ${rc} -eq 0 ]]; then
        write_status success complete 0
        printf 'Plntir Platform Update completed successfully.\n'
    else
        write_status failed "${stage}" "${rc}"
        printf 'Plntir Platform Update failed during %s (rc=%d).\n' "${stage}" "${rc}" >&2
    fi
    exit "${rc}"
}
trap on_exit EXIT
write_status running "${stage}" 0

if [[ $(/usr/bin/stat -f %Su "${PACKAGE_DIR}") != root ]]; then
    printf 'Package directory must be owned by root.\n' >&2
    exit 77
fi
unsafe_path=$(/usr/bin/find "${PACKAGE_DIR}" \( -perm -020 -o -perm -002 \) -print -quit)
if [[ -n ${unsafe_path} ]]; then
    printf 'Package contains a group/other-writable path: %s\n' "${unsafe_path}" >&2
    exit 77
fi
for archive in "${ENDPOINT_ARCHIVE}" "${ACCESS_ARCHIVE}"; do
    if [[ ! -f ${archive} || -L ${archive} ]]; then
        printf 'Unsafe or missing nested payload: %s\n' "${archive}" >&2
        exit 66
    fi
done
for required in \
    "${PACKAGE_DIR}/mac/libexec/plntir-integrity-check" \
    "${PACKAGE_DIR}/mac/launchd/com.plntir.endpoint-integrity.plist" \
    "${PACKAGE_DIR}/scripts/install-plntir-integrity-monitor.sh"; do
    if [[ ! -f ${required} || -L ${required} ]]; then
        printf 'Unsafe or missing integrity payload: %s\n' "${required}" >&2
        exit 66
    fi
done

verify_hash() {
    local archive=$1
    local expected=$2
    local actual
    actual=$(/usr/bin/shasum -a 256 "${archive}" | /usr/bin/awk '{print $1}')
    [[ ${actual} == "${expected}" ]] || {
        printf 'Nested payload checksum mismatch: %s\n' "${archive}" >&2
        return 65
    }
}
verify_hash "${ENDPOINT_ARCHIVE}" "${ENDPOINT_CHECKSUM}"
verify_hash "${ACCESS_ARCHIVE}" "${ACCESS_CHECKSUM}"

# keep every lower-privilege child out of the root-only extraction hierarchy.
cd /

workdir=$(/usr/bin/mktemp -d /private/var/tmp/plntir-platform-install.XXXXXX)

stage=endpoint-agent
write_status running "${stage}" 0
/usr/bin/install -d -m 0700 "${workdir}/endpoint"
/usr/bin/tar -xzf "${ENDPOINT_ARCHIVE}" -C "${workdir}/endpoint"
[[ -d ${workdir}/endpoint/plntir-endpoint-update &&
    ! -L ${workdir}/endpoint/plntir-endpoint-update ]] || exit 65
/usr/sbin/chown -R root:wheel "${workdir}/endpoint/plntir-endpoint-update"
/bin/chmod -R go-w "${workdir}/endpoint/plntir-endpoint-update"
"${workdir}/endpoint/plntir-endpoint-update/install.sh"

stage=secure-access
write_status running "${stage}" 0
/usr/bin/install -d -m 0700 "${workdir}/access"
/usr/bin/tar -xzf "${ACCESS_ARCHIVE}" -C "${workdir}/access"
[[ -d ${workdir}/access/plntir-access-upgrade &&
    ! -L ${workdir}/access/plntir-access-upgrade ]] || exit 65
/usr/sbin/chown -R root:wheel "${workdir}/access/plntir-access-upgrade"
/bin/chmod -R go-w "${workdir}/access/plntir-access-upgrade"
"${workdir}/access/plntir-access-upgrade/install.sh"

stage=integrity-alert-only
write_status running "${stage}" 0
"${PACKAGE_DIR}/scripts/install-plntir-integrity-monitor.sh" \
    "${PACKAGE_DIR}" macagent "${RELEASE_ID}"

printf 'No macOS privacy permission was changed; private-data access remains on-demand.\n'
finished=true
