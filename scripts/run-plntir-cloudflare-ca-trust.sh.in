#!/bin/bash
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
    printf 'Run with sudo from the physical Mac session.\n' >&2
    exit 1
fi

readonly SHARE_DIR=/Users/Shared/.plntir/inbox/cloudflare-ca-trust
readonly ARCHIVE=${SHARE_DIR}/plntir-cloudflare-ca-trust.tar.gz
readonly EXPECTED_CHECKSUM=@CHECKSUM@
readonly EXPECTED_OWNER=@OWNER@

if [[ -L ${SHARE_DIR} || ! -d ${SHARE_DIR} ]]; then
    printf 'Unsafe or missing Cloudflare CA package directory.\n' >&2
    exit 66
fi
if [[ $(/usr/bin/stat -f %Su "${SHARE_DIR}") != "${EXPECTED_OWNER}" ]]; then
    printf 'Unexpected Cloudflare CA package owner.\n' >&2
    exit 77
fi
unsafe_path=$(/usr/bin/find "${SHARE_DIR}" -maxdepth 1 \( -perm -020 -o -perm -002 \) -print -quit)
if [[ -n ${unsafe_path} ]]; then
    printf 'Cloudflare CA package contains a group/other-writable path: %s\n' "${unsafe_path}" >&2
    exit 77
fi
if [[ ! -f ${ARCHIVE} || -L ${ARCHIVE} ]]; then
    printf 'Unsafe or missing Cloudflare CA archive.\n' >&2
    exit 66
fi

stage=$(/usr/bin/mktemp -d /private/var/tmp/plntir-cloudflare-ca-trust.XXXXXX)
cleanup() {
    case ${stage} in
    /private/var/tmp/plntir-cloudflare-ca-trust.*)
        /bin/rm -rf "${stage}"
        ;;
    *)
        printf 'Refusing unsafe temporary cleanup path.\n' >&2
        ;;
    esac
}
trap cleanup EXIT

/bin/cp "${ARCHIVE}" "${stage}/package.tar.gz"
actual_checksum=$(/usr/bin/shasum -a 256 "${stage}/package.tar.gz" | /usr/bin/awk '{print $1}')
if [[ ${actual_checksum} != "${EXPECTED_CHECKSUM}" ]]; then
    printf 'Checksum mismatch; Cloudflare CA trust was not changed.\n' >&2
    exit 65
fi
/usr/bin/tar -xzf "${stage}/package.tar.gz" -C "${stage}"
if [[ ! -d ${stage}/plntir-cloudflare-ca-trust || -L ${stage}/plntir-cloudflare-ca-trust ]]; then
    printf 'Archive layout is invalid.\n' >&2
    exit 65
fi
/usr/sbin/chown -R root:wheel "${stage}/plntir-cloudflare-ca-trust"
/bin/chmod -R go-w "${stage}/plntir-cloudflare-ca-trust"
"${stage}/plntir-cloudflare-ca-trust/install.sh"
