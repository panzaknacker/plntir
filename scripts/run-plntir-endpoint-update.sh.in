#!/bin/bash
set -Eeuo pipefail

if [[ ${EUID} -ne 0 ]]; then
    printf 'Run with sudo from an authenticated Plntir administrator session.\n' >&2
    exit 1
fi

readonly SHARE_DIR=/Users/Shared/.plntir/inbox/endpoint-update
readonly ARCHIVE=${SHARE_DIR}/plntir-endpoint-update.tar.gz
readonly EXPECTED_CHECKSUM=@CHECKSUM@
readonly EXPECTED_OWNER=@OWNER@

if [[ -L ${SHARE_DIR} || ! -d ${SHARE_DIR} ]]; then
    printf 'Unsafe or missing update directory.\n' >&2
    exit 66
fi
if [[ $(/usr/bin/stat -f %Su "${SHARE_DIR}") != "${EXPECTED_OWNER}" ]]; then
    printf 'Unexpected update-directory owner.\n' >&2
    exit 77
fi
unsafe_path=$(/usr/bin/find "${SHARE_DIR}" -maxdepth 1 \( -perm -020 -o -perm -002 \) -print -quit)
if [[ -n ${unsafe_path} ]]; then
    printf 'Update directory contains a group/other-writable path: %s\n' "${unsafe_path}" >&2
    exit 77
fi
if [[ ! -f ${ARCHIVE} || -L ${ARCHIVE} ]]; then
    printf 'Unsafe or missing update archive.\n' >&2
    exit 66
fi

stage=$(/usr/bin/mktemp -d /private/var/tmp/plntir-endpoint-update.XXXXXX)
cleanup() {
    case ${stage} in
    /private/var/tmp/plntir-endpoint-update.*)
        /bin/rm -rf "${stage}"
        ;;
    *)
        printf 'Refusing unsafe temporary cleanup path.\n' >&2
        ;;
    esac
}
trap cleanup EXIT

/bin/cp "${ARCHIVE}" "${stage}/update.tar.gz"
actual_checksum=$(/usr/bin/shasum -a 256 "${stage}/update.tar.gz" | /usr/bin/awk '{print $1}')
if [[ ${actual_checksum} != "${EXPECTED_CHECKSUM}" ]]; then
    printf 'Checksum mismatch; update was not executed.\n' >&2
    exit 65
fi
/usr/bin/tar -xzf "${stage}/update.tar.gz" -C "${stage}"
if [[ ! -d ${stage}/plntir-endpoint-update || -L ${stage}/plntir-endpoint-update ]]; then
    printf 'Archive layout is invalid.\n' >&2
    exit 65
fi
/usr/sbin/chown -R root:wheel "${stage}/plntir-endpoint-update"
/bin/chmod -R go-w "${stage}/plntir-endpoint-update"
"${stage}/plntir-endpoint-update/install.sh"
